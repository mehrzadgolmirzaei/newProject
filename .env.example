# ── دیتابیس (PostgreSQL — در توسعه و production یکسان) ──
DATABASE_URL="postgresql://viora:viora@localhost:5432/viora?schema=public"

# آدرس عمومی سایت (برای لینک‌ها، sitemap و بررسی Origin)
SITE_URL="http://localhost:3000"

# public ← فهرست و محتوای موارد برای همه قابل مشاهده است (پاسخ و بحث فقط برای اعضای تأییدشده)
# members ← کل اطلس فقط برای اعضای تأییدشده
ATLAS_VISIBILITY="public"

# رمز داخلی برای هش کدهای پیامکی — یک رشته‌ی تصادفی ۳۲+ نویسه (openssl rand -base64 48)
AUTH_SECRET="replace-with-a-long-random-string"

# ── ورود ──
# password ← ورود با نام کاربری و رمز عبور (پیش‌فرض)
# otp      ← ورود با شماره‌ی موبایل و کد پیامکی (نیازمند تنظیمات پیامک در ادامه)
AUTH_METHOD="password"

# ── پیامک (فقط برای AUTH_METHOD=otp) ──
# console ← کد در لاگ سرور چاپ می‌شود (فقط توسعه)
# kavenegar | smsir ← ارسال واقعی با الگوی «تأیید» پنل پیامک
SMS_DRIVER="console"
SMS_API_KEY=""
# کاوه‌نگار: نام الگو (template)  —  sms.ir: شناسه‌ی عددی قالب (templateId)
SMS_TEMPLATE=""

# ── فضای ذخیره‌سازی فایل‌ها ──
# local ← پوشه‌ی STORAGE_DIR روی همین سرور (توسعه یا VPS تک‌سرور)
# s3    ← هر سرویس سازگار با S3 (فضای ابری لیارا، آروان، MinIO)
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="default"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# آدرس عمومی باکت؛ مثلاً https://viora-media.storage.c2.liara.space
MEDIA_PUBLIC_URL=""

# سقف حجم هر فایل آپلودی (مگابایت) — اسلایدهای کامل ممکن است چند گیگابایت باشند
MAX_UPLOAD_MB="4096"
# مسیر برنامه‌ی vips برای تبدیل اسلاید کامل (SVS/NDPI/MRXS). خالی ← آپلود WSI غیرفعال
VIPS_BIN=""
