{
  "name": "viora-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Viora Pathobiology — educational atlas of difficult pathology cases",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test \"src/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file=.env --conditions=react-server --import tsx prisma/seed.ts",
    "demo:clear": "node --env-file=.env --conditions=react-server --import tsx scripts/demo-clear.ts",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "media:reprocess": "node --env-file=.env --conditions=react-server --import tsx scripts/reprocess-media.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fontsource-variable/vazirmatn": "^5.2.5",
    "@prisma/client": "^6.16.0",
    "next": "^16.0.10",
    "openseadragon": "^5.0.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "prisma": {
    "seed": "node --env-file=.env --conditions=react-server --import tsx prisma/seed.ts"
  }
}
